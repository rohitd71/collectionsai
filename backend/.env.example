# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Publicly reachable base URL for this API (used to verify Twilio's webhook
# signature, which is computed over the exact URL Twilio POSTed to).
PUBLIC_BACKEND_URL=http://localhost:4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Vapi
VAPI_API_KEY=replace-with-vapi-key
VAPI_ASSISTANT_ID=replace-with-assistant-id
BUSINESS_PHONE_NUMBER=+14165550100
# Custom header value configured on the Vapi server-URL webhook; verified on
# every inbound /webhooks/vapi request so results can't be forged.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Twilio
TWILIO_ACCOUNT_SID=replace-with-twilio-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_PHONE_NUMBER=+14165550100

# Claude / Anthropic
ANTHROPIC_API_KEY=replace-with-anthropic-key

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# CORS
FRONTEND_URL=http://localhost:5173
